 using namespace nux;
@@ -42,6 +49,47 @@ TEST_F(TestGraphicsDisplay, X11Timestamp
   EXPECT_EQ(xevent.xbutton.time, event_time);
 }
 
+// A fullscreen window switches to the XF86VidMode mode of its size and frees
+// the mode list; the destructor then freed the same list a second time. The
+// display is created and destroyed in a child process that runs with glibc's
+// malloc checking, so the second free aborts it.
+TEST(TestGraphicsDisplayFullscreen, DestroyAfterModeSwitchFreesModeListOnce)
+{
+  Display* dpy = XOpenDisplay(NULL);
+  ASSERT_NE(dpy, nullptr);
+  int event_base, error_base, num_modes = 0;
+  XF86VidModeModeInfo** modes = NULL;
+  bool have_modes = XF86VidModeQueryExtension(dpy, &event_base, &error_base)
+                    && XF86VidModeGetAllModeLines(dpy, DefaultScreen(dpy), &num_modes, &modes)
+                    && num_modes > 0;
+  // The first mode is the current one, so fullscreen at its size switches to it.
+  int width = have_modes ? modes[0]->hdisplay : 0;
+  int height = have_modes ? modes[0]->vdisplay : 0;
+  XFree(modes);
+  XCloseDisplay(dpy);
+
+  if (!have_modes)
+    GTEST_SKIP() << "the X server has no XF86VidMode modes, no fullscreen branch";
+
+  // The child is a new exec of this test, so it inherits the environment.
+  GTEST_FLAG_SET(death_test_style, "threadsafe");
+  g_setenv("LD_PRELOAD", "libc_malloc_debug.so.0", TRUE);
+  g_setenv("GLIBC_TUNABLES", "glibc.malloc.check=3", TRUE);
+
+  EXPECT_EXIT({
+    nux::NuxCoreInitialize(0);
+    nux::NuxGraphicsInitialize();
+    nux::GraphicsDisplay* display =
+      gGLWindowManager.CreateGLWindow("nux::TestGraphicsDisplayFullscreen", width, height,
+                                      nux::WINDOWSTYLE_NORMAL, 0, true, false);
+    delete display;
+    _exit(display ? 0 : 2);
+  }, ::testing::ExitedWithCode(0), "");
+
+  g_unsetenv("LD_PRELOAD");
+  g_unsetenv("GLIBC_TUNABLES");
+}
+
 #endif
 
 }
